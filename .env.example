# Copy to .env and fill in. Never commit the resulting .env file.

# Database Configuration
# Required -- the app throws on startup if this is missing.
MONGODB_URI=mongodb://localhost:27017/easyshop

# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# JWT Configuration
# Required. Minimum 32 characters -- there is no fallback value.
# Generate with: openssl rand -hex 32
JWT_SECRET=
