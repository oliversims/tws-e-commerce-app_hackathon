# Use Node.js 18 Alpine as base
FROM node:18-alpine

# Set working directory
WORKDIR /app

# Install necessary build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files and tsconfig (scripts project for ts-node)
COPY package*.json tsconfig.json tsconfig.scripts.json ./

# Copy scripts and data
COPY scripts ./scripts
COPY .db ./.db

# Install dependencies
RUN npm install
RUN npm install --save-dev @types/mongoose

# Set environment variables
ENV NODE_ENV=development

# Command to run migration
CMD ["npx", "ts-node", "--project", "tsconfig.scripts.json", "scripts/migrate-data.ts"]
